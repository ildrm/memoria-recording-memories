APP_NAME=Memoria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public identifier embedded in Livewire snapshots. Production must replace the
# local default with the immutable commit SHA or image digest for each release.
LIVEWIRE_RELEASE_TOKEN=a
# Production requires distinct, operator-reviewed public HTTPS documents.
MEMORIA_PRIVACY_NOTICE_URL=
MEMORIA_TERMS_OF_SERVICE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
# Comma-separated proxy/load-balancer IPs or CIDRs; never use * on an
# internet-reachable origin unless the platform guarantees header scrubbing.
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
# Multi-instance production: use the cache driver and a shared cache store.
# APP_MAINTENANCE_DRIVER=cache
# APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Production/Docker PostgreSQL placeholders:
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=memoria
# DB_USERNAME=memoria
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_DRIVER=redis and SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
# Production: QUEUE_CONNECTION=redis
# Must stay above the longest job timeout (exports currently allow 900 seconds).
DB_QUEUE_RETRY_AFTER=960

# Memoria serves approved derivatives through guarded controllers. The public
# disk is a deny-boundary sentinel and must not be selected for sanitized media.
MEMORIA_PRIVATE_DISK=local
MEMORIA_PUBLIC_DISK=public
# Must be private/non-web-linked; guarded controllers stream sanitized derivatives.
MEMORIA_SANITIZED_MEDIA_DISK=local
MEMORIA_EXPORT_DISK=local
MEMORIA_ATTACHMENT_MAX_KILOBYTES=20480
MEMORIA_AUTOSAVE_VERSION_INTERVAL=15
# `fake` is accepted only in local/testing. Production should use `clamav`.
# Mount a continuously updated signature database at /var/lib/clamav; the
# release check runs an in-memory EICAR probe and fails if detection is broken.
MEMORIA_ATTACHMENT_SCANNER=fake
MEMORIA_CLAMAV_BINARY=clamscan
MEMORIA_ATTACHMENT_SCAN_TIMEOUT=60

# Multi-instance production must use shared private temporary-upload storage.
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=memoria_private_s3

CACHE_STORE=database
# Production: CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=960

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production object-storage boundaries (use separate buckets where possible,
# otherwise these distinct roots remain mandatory).
MEMORIA_AWS_PRIVATE_BUCKET=
MEMORIA_AWS_PRIVATE_ROOT=private
MEMORIA_AWS_SANITIZED_BUCKET=
MEMORIA_AWS_SANITIZED_ROOT=sanitized-media
MEMORIA_AWS_EXPORTS_BUCKET=
MEMORIA_AWS_EXPORTS_ROOT=exports
# Production disk selections after installing the S3 Flysystem adapter:
# MEMORIA_PRIVATE_DISK=memoria_private_s3
# MEMORIA_SANITIZED_MEDIA_DISK=memoria_sanitized_s3
# MEMORIA_EXPORT_DISK=memoria_exports_s3

# OAuth connections. Register these exact callback URLs with each provider.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI="${APP_URL}/app/connected-accounts/x/callback"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/app/connected-accounts/linkedin/callback"
# Reserved for a reviewed Facebook Page chooser/Page-token exchange; the shipped
# UI keeps Facebook onboarding unavailable rather than starting profile OAuth.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/app/connected-accounts/facebook/callback"

# The fake driver never performs external requests and is restricted to local/testing.
# Production must explicitly use `disabled`, or `real` after provider review.
# MEMORIA_SOCIAL_DRIVER=disabled
# MEMORIA_SOCIAL_DRIVER=real
# Keep version pins explicit and review provider changelogs before rotating them.
MEMORIA_SOCIAL_DRIVER=fake
MEMORIA_SOCIAL_CONNECT_TIMEOUT=3
MEMORIA_SOCIAL_TIMEOUT=15
MEMORIA_SOCIAL_LOCK_SECONDS=60
MEMORIA_LINKEDIN_VERSION=202606
MEMORIA_FACEBOOK_GRAPH_VERSION=v25.0

MEMORIA_SHARE_TOKEN_BYTES=32
MEMORIA_SHARE_EXPIRATION_DAYS=30
MEMORIA_SHARE_MAX_EXPIRATION_DAYS=365
MEMORIA_SHARE_ACCESS_SESSION_MINUTES=60
MEMORIA_EXPORT_EXPIRATION_HOURS=72
MEMORIA_EXPORT_CHUNK_SIZE=100
MEMORIA_EXPORT_DIRECTORY=exports
MEMORIA_FILE_CLEANUP_RETRY_HOURS=24
MEMORIA_SCHEDULER_BATCH_SIZE=100
# Maximum publication URLs in each paginated child sitemap (protocol max: 50000).
MEMORIA_SITEMAP_MAXIMUM_URLS=5000
MEMORIA_SITEMAP_CACHE_SECONDS=900
MEMORIA_SITEMAP_LOCK_SECONDS=30

# Public pages omit unsafe-eval. Filament/Livewire panels require their scoped policy.
MEMORIA_CONTENT_SECURITY_POLICY="default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
MEMORIA_PANEL_CONTENT_SECURITY_POLICY="default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"

VITE_APP_NAME="${APP_NAME}"
